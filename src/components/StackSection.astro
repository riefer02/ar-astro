---
import SectionHeader from "./SectionHeader";
import Hairline from "./Hairline";
import stack from "../lib/professional-skills.json";

const groups = stack.groups;
---

<section id="stack" class="grounded-section section-pad relative">
  <Hairline className="via-border" />
  <div class="container mx-auto px-4">
    <SectionHeader
      className="mb-14"
      kicker="Stack"
      title="What I build with"
      description="The fundamentals come first — systems thinking, API design, and knowing when not to build. These are what I reach for when they reduce friction."
    />

    <div class="mx-auto max-w-5xl space-y-6">
      {
        groups.map((group) => (
          <div class="grounded-panel rounded-lg p-5 md:p-6">
            <h3
              class="mb-5 text-xs font-bold uppercase tracking-widest text-muted-foreground"
            >
              {group.name}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span
                  class="grounded-chip inline-flex items-center rounded-md px-3 py-1 text-sm font-normal text-muted-foreground"
                >
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
