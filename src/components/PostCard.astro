---
import { ArrowRight } from "lucide-react";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@/components/ui/card";
import { Image } from "astro:assets";
import { formatDate } from "../lib/format";

const { post } = Astro.props;
const { title, description, pubDate, image } = post.data;
---

<article class="h-full">
  <Card
    className="grounded-panel card-lift group relative mx-auto flex h-full max-w-md flex-col justify-between focus-within:ring-2 focus-within:ring-ring focus-within:ring-offset-2 focus-within:ring-offset-background"
  >
    <div class="flex h-full flex-col">
      <CardHeader className="overflow-hidden p-0">
        <Image
          src={image.url}
          alt={image.alt}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, 400px"
          class="h-48 w-full rounded-t-[inherit] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </CardHeader>
      <CardContent className="flex flex-1 flex-col justify-between p-5">
        <div>
          <CardTitle className="mb-2 line-clamp-2 text-xl font-bold">
            <a
              href={`/posts/${post.id}/`}
              class="text-foreground transition-colors duration-200 after:absolute after:inset-0 after:content-[''] group-hover:text-primary focus-visible:outline-none"
            >
              {title}
            </a>
          </CardTitle>
          <CardDescription className="mb-4 line-clamp-3 text-sm text-muted-foreground">
            {description}
          </CardDescription>
        </div>
        <div class="mt-2 flex items-center justify-between gap-4">
          <p class="text-xs text-muted-foreground">{formatDate(pubDate)}</p>
          <span
            class="inline-flex items-center gap-1 text-xs font-medium text-primary transition-colors group-hover:text-foreground"
          >
            Read article
            <ArrowRight
              className="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true"
            />
          </span>
        </div>
      </CardContent>
    </div>
  </Card>
</article>
