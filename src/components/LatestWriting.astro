---
import { getSortedPosts } from "../lib/content";
import PostCard from "./PostCard.astro";
import SectionHeader from "./SectionHeader";
import Hairline from "./Hairline";

const posts = (await getSortedPosts()).slice(0, 3);
---

<section id="writing" class="grounded-section section-pad relative">
  <Hairline className="via-border" />
  <div class="container mx-auto px-4">
    <SectionHeader
      className="mb-16"
      kicker="Writing"
      title="Latest Writing"
      description="Long-form thinking on AI, work, and what we do with technology."
    />

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/posts/"
        class="inline-flex items-center text-foreground transition-colors hover:text-muted-foreground"
      >
        View all writing
        <svg
          class="ml-2 h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>
