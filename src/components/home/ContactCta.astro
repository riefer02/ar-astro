---
import { ArrowRight } from "lucide-react";
---

<section aria-label="Contact">
  <div
    class="grounded-panel flex flex-col gap-4 rounded-lg px-6 py-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h2 class="text-lg font-semibold text-foreground">
        Let's start a conversation
      </h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Projects, consulting, or a good conversation about technology, music, or
        philosophy.
      </p>
    </div>
    <a
      href="/contact/"
      class="inline-flex h-10 shrink-0 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
    >
      Get in touch
      <ArrowRight className="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</section>
