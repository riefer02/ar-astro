---
import { jobTitle } from "../../lib/site";

const consoleRows = [
  { key: "role", value: "Senior Software Engineer & AI Specialist" },
  { key: "focus", value: "AI agents · full-stack" },
  { key: "status", value: "Systems online", dot: true },
  { key: "stack", value: "TypeScript · Python · AWS" },
];
---

<section class="border-b border-border">
  <div
    class="container mx-auto grid items-center gap-10 px-4 pt-12 pb-12 md:pt-16 md:pb-16 lg:grid-cols-12 lg:gap-12"
  >
    <div class="lg:col-span-7">
      <p
        class="font-mono text-xs uppercase tracking-widest text-muted-foreground"
      >
        {jobTitle}
      </p>
      <h1
        class="mt-5 max-w-3xl text-4xl font-bold leading-[1.05] tracking-tight text-foreground sm:text-5xl lg:text-6xl"
      >
        <span class="sr-only">Andrew Riefenstahl — {jobTitle} — </span>
        Forging the Future of{" "}
        <span class="text-glint">Digital Intelligence</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        I&apos;m <strong class="font-semibold text-foreground"
          >Andrew Riefenstahl</strong
        >, senior software engineer and AI specialist. I build resilient systems
        and write about where AI and humanity meet.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn-grounded-primary">Explore work</a>
        <a href="/posts/" class="btn-grounded-outline">Read writing</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="grounded-panel rounded-lg">
        <div class="flex items-center gap-3 border-b border-border px-4 py-3">
          <span class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-border"></span>
          </span>
          <span class="font-mono text-xs text-muted-foreground">~/andrew</span>
        </div>
        <dl class="divide-y divide-border font-mono text-sm">
          {
            consoleRows.map((row) => (
              <div class="flex gap-4 px-4 py-3">
                <dt class="w-16 shrink-0 text-muted-foreground">{row.key}</dt>
                <dd class="min-w-0 text-foreground">
                  {row.dot && (
                    <span
                      class="mr-2 inline-block h-2 w-2 rounded-full bg-primary align-middle"
                      aria-hidden="true"
                    />
                  )}
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
