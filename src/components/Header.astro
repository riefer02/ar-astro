---
import { Image } from "astro:assets";
import MobileNav from "./MobileNav";
import DesktopNav from "./DesktopNav";
import ThemeToggle from "./ThemeToggle";
const { title } = Astro.props;
import profileImage from "../assets/Andrew-Riefenstahl.jpg";
---

<header
  class="fixed top-0 z-50 w-full border-b border-foreground/10 bg-gradient-to-b from-[hsl(var(--header-from)/0.98)] to-[hsl(var(--header-to)/0.96)] shadow-[0_12px_40px_-28px_hsl(var(--depth-shadow)/0.9),inset_0_-1px_0_hsl(var(--foreground)/0.08)] transition-colors duration-300"
>
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4"
  >
    <!-- Logo/Brand Section -->
    <div class="flex items-center space-x-3">
      <a href="/" class="group flex items-center space-x-3">
        <div class="relative">
          <Image
            src={profileImage}
            alt="Andrew Riefenstahl profile"
            width={80}
            height={80}
            loading="eager"
            class="h-10 w-10 rounded-full ring-2 ring-foreground/15 transition-all duration-200 group-hover:ring-glint/50"
          />
          <div
            class="absolute inset-0 rounded-full bg-gradient-to-tr from-background/15 to-transparent"
          >
          </div>
        </div>
        <div class="hidden sm:block">
          <span
            class="text-xl font-bold text-primary-foreground transition-colors duration-200 group-hover:text-primary-foreground"
          >
            Andrew Riefenstahl
          </span>
          <p class="-mt-1 text-sm font-medium text-primary-foreground/80">
            Developer & Thought Leader
          </p>
        </div>
      </a>
    </div>

    <!-- Navigation Section -->
    <div class="flex items-center space-x-2 sm:space-x-4">
      <!-- Desktop Navigation -->
      <DesktopNav />

      <!-- Theme Toggle -->
      <ThemeToggle client:load />

      <!-- Mobile Navigation -->
      <MobileNav client:load />
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-20"></div>
