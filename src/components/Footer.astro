---
import { socials } from "../lib/socials";

const year = new Date().getFullYear();

const nav = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/posts/", label: "Writing" },
  { href: "/#connect", label: "Contact" },
];
---

<footer class="border-t border-border/70 bg-background/40">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div
      class="flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-between"
    >
      <div class="text-center md:text-left">
        <p class="text-lg font-bold text-foreground">Andrew Riefenstahl</p>
        <p class="text-sm text-muted-foreground">
          Senior software engineer &amp; AI specialist
        </p>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-6">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-5">
        {socials.map((s) => (
          <a
            href={s.url}
            target={s.url.startsWith("http") ? "_blank" : undefined}
            rel={s.url.startsWith("http") ? "noopener noreferrer" : undefined}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {s.name}
          </a>
        ))}
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border/50 pt-6 text-sm text-muted-foreground md:flex-row"
    >
      <p>&copy; {year} Andrew Riefenstahl</p>
      <a
        href="/games/dragon-quest/"
        class="text-xs text-muted-foreground/60 no-underline transition-colors hover:text-muted-foreground"
        aria-label="A secret"
        >🐉</a
      >
    </div>
  </div>
</footer>
