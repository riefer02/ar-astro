---
import Layout from "../layouts/Layout.astro";
import Analytics from "../components/Analytics.astro";
import HeroSection from "../components/HeroSection";
import LatestWriting from "../components/LatestWriting.astro";
import ExpertiseSection from "../components/ExpertiseSection";
import EnhancedKeyProjects from "../components/EnhancedKeyProjects";
import StackSection from "../components/StackSection.astro";
import ConnectSection from "../components/ConnectSection";
import keyProjects from "../lib/key-projects.json";

const metaTags = {
  title: "Andrew Riefenstahl | Senior Software Engineer & AI Specialist",
  description:
    "Andrew Riefenstahl is a senior software engineer and AI specialist building resilient systems and writing about where AI and humanity meet. Explore projects, writing, and how he can help.",
  url: "https://andrewriefenstahl.com",
  twitterHandle: "@riefer02",
};
---

<Layout metaTags={metaTags}>
  <Analytics />

  <!-- Modern spacing and structure -->
  <div class="space-y-0">
    <!-- Hero Section -->
    <HeroSection />

    <!-- Latest Writing -->
    <LatestWriting />

    <!-- Expertise Section -->
    <ExpertiseSection />

    <!-- Enhanced Projects Section -->
    <EnhancedKeyProjects keyProjects={keyProjects} />

    <!-- Stack Section -->
    <StackSection />

    <!-- Services Teaser -->
    <section class="grounded-section section-pad relative">
      <div class="container mx-auto max-w-5xl px-4">
        <div
          class="grounded-panel relative overflow-hidden rounded-lg px-6 py-12 text-center md:px-10"
        >
          <div class="relative z-10">
            <h2
              class="grounded-section-heading mb-4 text-3xl font-bold tracking-tight text-foreground md:text-5xl"
            >
              Need something built or fixed?
            </h2>
            <p class="mx-auto mb-8 max-w-xl text-lg text-muted-foreground">
              I help individuals and small businesses reduce friction — making
              the time-eating parts of their work simpler, with AI only where it
              actually earns its place.
            </p>
            <a href="/services/" class="btn-grounded-primary">
              See how I can help
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Connect Section -->
    <ConnectSection />
  </div>
</Layout>
