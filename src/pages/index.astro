---
import Layout from "../layouts/Layout.astro";
import Analytics from "../components/Analytics.astro";
import Hero from "../components/home/Hero.astro";
import SelectedWork from "../components/home/SelectedWork.astro";
import WritingList from "../components/home/WritingList.astro";
import Capabilities from "../components/home/Capabilities.astro";
import ContactCta from "../components/home/ContactCta.astro";
import keyProjects from "../lib/key-projects.json";

const metaTags = {
  title: "Andrew Riefenstahl | Senior Software Engineer & AI Specialist",
  description:
    "Andrew Riefenstahl is a senior software engineer and AI specialist building resilient systems and writing about where AI and humanity meet. Explore projects, writing, and how he can help.",
  url: "https://andrewriefenstahl.com",
  twitterHandle: "@riefer02",
};
---

<Layout metaTags={metaTags}>
  <Analytics />

  <Hero />

  <div class="container mx-auto space-y-6 px-4 py-10 md:space-y-8 md:py-14">
    <SelectedWork projects={keyProjects.projects} />

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <WritingList />
      </div>
      <div class="lg:col-span-2">
        <Capabilities />
      </div>
    </div>

    <ContactCta />
  </div>
</Layout>
