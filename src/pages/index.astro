---
import Layout from "../layouts/Layout.astro";
import Analytics from "../components/Analytics.astro";
import HeroSection from "../components/HeroSection";
import LatestWriting from "../components/LatestWriting.astro";
import ExpertiseSection from "../components/ExpertiseSection";
import EnhancedKeyProjects from "../components/EnhancedKeyProjects";
import StackSection from "../components/StackSection.astro";
import ConnectSection from "../components/ConnectSection";
import keyProjects from "../lib/key-projects.json";

const metaTags = {
  title: "Andrew Riefenstahl | Senior Software Engineer & AI Specialist",
  description:
    "Andrew Riefenstahl is a senior software engineer and AI specialist building resilient systems and writing about where AI and humanity meet. Explore projects, writing, and how he can help.",
  url: "https://andrewriefenstahl.com",
  twitterHandle: "@riefer02",
};
---

<Layout metaTags={metaTags}>
  <Analytics />

  <!-- Modern spacing and structure -->
  <div class="space-y-0">
    <!-- Hero Section -->
    <HeroSection />

    <!-- Latest Writing -->
    <LatestWriting />

    <!-- Expertise Section -->
    <ExpertiseSection />

    <!-- Enhanced Projects Section -->
    <EnhancedKeyProjects keyProjects={keyProjects} />

    <!-- Stack Section -->
    <StackSection />

    <!-- Connect Section -->
    <ConnectSection />
  </div>
</Layout>
